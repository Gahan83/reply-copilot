# Copy to .env.local for local dev with `vercel dev`. Never commit real keys.

# Full Target URI from the Azure portal (includes ?api-version=...).
AZURE_OPENAI_ENDPOINT=https://emi-ts-shared-we-oai.openai.azure.com/openai/responses?api-version=2025-03-01-preview

# The key from the Azure portal.
AZURE_OPENAI_KEY=your-azure-openai-key-here

# Deployment name.
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
